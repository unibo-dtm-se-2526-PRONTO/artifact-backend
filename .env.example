#template to create the local, not versioned .env file with the credentials for the db connection

#db
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# require (the default) for the hosted database; disable for a local
# PostgreSQL without SSL. docker compose sets it for its own db container
DB_SSLMODE=require

#tests
# empty: tests run on in-memory SQLite. Set it to run them on PostgreSQL, e.g.
# the db container of docker compose:
# TEST_DATABASE_URL=postgres://pronto:pronto@localhost:5432/pronto?sslmode=disable
TEST_DATABASE_URL=

#django
SECRET_KEY=
DEBUG=True
# comma-separated; required once DEBUG is off
ALLOWED_HOSTS=localhost,127.0.0.1

#email
# console prints e-mails in the terminal; set to
# django.core.mail.backends.smtp.EmailBackend to deliver them
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pronto.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
